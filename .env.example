# Copy to .env and fill in. The .env file never goes to git.

# Random string, 32+ characters: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Token of the bot from @BotFather. Add this bot to every channel as an administrator who can post.
BOT_TOKEN=

# Times in the panel are in this time zone (daylight saving time handled)
TIMEZONE=Europe/Rome
TEAM_NAME=Trattoria Laurin · Social

# Panel address. Behind HTTPS (nginx/Caddy) set COOKIE_SECURE=true.
HOST=127.0.0.1
PORT=8095
COOKIE_SECURE=false

# Database and uploaded photos
DATA_DIR=data

# Optional AI help for authors (shorter, friendlier, translate…). off = no AI.
AI_MODE=off
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
AI_DAILY_LIMIT=100
